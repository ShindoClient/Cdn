{
  "name": "@shindo/cdn",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n web,api -c cyan,yellow \"vite dev\" \"cargo run --bin server\"",
    "dev:web": "vite dev",
    "dev:api": "cargo run --bin server",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:api": "cargo check",
    "fmt": "cargo fmt"
  },
  "devDependencies": {
    "@lucide/svelte": "^1.64.0",
    "@sveltejs/adapter-vercel": "^7.0.1",
    "@sveltejs/kit": "^3.1.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.6",
    "concurrently": "^10.0.6",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.7",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.3.5"
  },
  "imports": {
    "#lib": "./src/lib/index.js",
    "#lib/*": "./src/lib/*"
  },
  "engines": {
    "bun": ">=1.1.0"
  },
  "packageManager": "bun@1.4.4",
  "dependencies": {
    "@vercel/analytics": "^2.0.1"
  }
}
